# Copy to .env and fill in real values. Never commit the filled-in file.

DATABASE_URL="file:./dev.db"

# Sign the session cookie. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Survey routers
# ---------------------------------------------------------------------------
# Comma-separated provider keys that are live. A key listed here must match the
# `provider` column on its surveys, and its postback URL becomes
# /api/postback/<key>. Leave empty to run on the built-in demo surveys only.
PROVIDERS=""

# Template for one provider (repeat per key, upper-cased). Take the exact
# parameter names, signature recipe and status codes from that router's own
# integration docs and confirm them with a test postback before going live —
# a wrong mapping silently drops completions.
#
# PROVIDER_TRAYISTATS_LABEL="TrayiStats"
# PROVIDER_TRAYISTATS_PUBLISHER_ID=""
# PROVIDER_TRAYISTATS_API_KEY=""
# PROVIDER_TRAYISTATS_SECRET=""
# PROVIDER_TRAYISTATS_ENTRY_URL="https://router.example/enter?vid={publisherId}&uid={userId}&tx={txId}&country={country}"
# PROVIDER_TRAYISTATS_SIG_MODE="hmac-sha256"      # none | md5 | sha1 | sha256 | hmac-sha256
# PROVIDER_TRAYISTATS_SIG_PARAM="hash"
# What gets hashed. Defaults to "{txId}{payout}" for hmac-sha256 (the secret is the
# HMAC key) and "{txId}{payout}{secret}" for the plain digest modes. Any postback
# parameter can be referenced by name, plus {secret} and {publisherId}.
# PROVIDER_TRAYISTATS_SIG_TEMPLATE="{txId}{payout}"
# PROVIDER_TRAYISTATS_P_TXID="tx"
# PROVIDER_TRAYISTATS_P_PAYOUT="payout"
# PROVIDER_TRAYISTATS_P_STATUS="status"
# PROVIDER_TRAYISTATS_PAYOUT_UNIT="usd"           # usd | cents
# PROVIDER_TRAYISTATS_STATUS_OK="1,complete"
# PROVIDER_TRAYISTATS_STATUS_REVERSE="2,reversal"
# PROVIDER_TRAYISTATS_STATUS_SCREEN="3,screenout"
# PROVIDER_TRAYISTATS_IP_ALLOWLIST=""             # postback source IPs, strongly recommended

# ---------------------------------------------------------------------------
# Fraud screening (optional)
# ---------------------------------------------------------------------------
# Proxy/VPN/datacenter lookup. Disabled entirely while unset — no outbound calls.
# IP_INTEL_URL="https://vendor.example/check?ip={ip}&key=YOUR_KEY"
# IP_INTEL_FLAG_FIELD="proxy"
